class Solution {
    public int[] twoSum(int[] nums, int target) {
      // First we will create a hash map 
      HashMap<Integer,Integer> map = new HashMap<>();
      // Create an int array of size 2 as we want to return output with 2 indexes
      int[] arr = new int[2];
      // Iterate a loop and check if target-arr[i] is present in map then return result
      // Else put the index of current element in the map
      for(int i=0;i<nums.length;i++){
        if(map.containsKey(target-nums[i])){
            arr[0]=map.get(target-nums[i]);
            arr[1]=i;
            return arr;
        }else map.put(nums[i],i);
      }
      return arr;
    }
}
