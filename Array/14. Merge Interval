import java.lang.*;
class Solution {
    public int[][] merge(int[][] intervals) {
        // Sort on the basis of start interval it will ease overlap merging
        Arrays.sort(intervals,(a,b)->a[0]-b[0]);
        // [[1,3],[2,6],[8,10],[15,18]]
        int[] current = intervals[0]; // current --> [1,3]
        // Create one result array list
        List<int[]> res = new ArrayList<>();
        for(int i=1;i<intervals.length;i++){
            // store the next interval
            int[ ] next = intervals[i];
            // Check overlapping
            if(next[0]<=current[1]){
                // In this case overlapping happens so just merge the interval
                current[1]=Math.max(current[1],next[1]);
            }
            else{
                // In case overlapping is not happening just need to add in res and check with next interval
                   res.add(current);
                   current = next;
                }
        }
        // add the last interval
        res.add(current);
        return res.toArray(new int[res.size()][]);
    }
}

// Time complexity is o(nlogn) and space complexity is o(n)
