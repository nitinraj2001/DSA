class Solution {
    public int maxProfit(int[] prices) {
        // let's say if array has single digit then return
        if(prices.length == 1 || prices.length == 0) return 0;
        // Assume that purchased price will be the first day price
        int purchasedPrice = prices[0];
        int profit = 0;
        // Handle case like if array size is 2 and second day price is more
        if(prices.length==2&&prices[1]>prices[0])return prices[1]-prices[0];
        // Iterate the loop over prices and 
        // Check if any smaller value found in next day it will be the purchased price
        for(int i = 1; i<=prices.length-1;i++){
            if(prices[i]<purchasedPrice)purchasedPrice = prices[i];
            profit = (prices[i]-purchasedPrice)>0 && (prices[i]-purchasedPrice)>profit
                      ?(prices[i]-purchasedPrice):profit;
        }
        return profit;
        
    }
}
