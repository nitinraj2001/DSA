class Solution {
    public int findMaxConsecutiveOnes(int[] nums) {
        int max = 0; // It's a global max just to make sure max wouldn't get loss if streak is in middle
        int currentMax = 0;
        for(int i = 0; i< nums.length; i++){
            if(nums[i]==1){
                currentMax=currentMax+1;
                max = Math.max(currentMax,max);
            }else currentMax=0;
        }
        return max;
    }
}
