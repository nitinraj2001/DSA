class Solution {
    // In this approch we have to use prefix sum + hashMap as sliding window approach will not work
    // Since given array could have negative numbers also
    public int subarraySum(int[] nums, int k) {
        int count = 0;
        int sum = 0;
        HashMap<Integer, Integer> res = new HashMap<>();
        res.put(0,1); // This is added for base case so that it estimate that there could be subarray that start from 0th index
        for(int num:nums){
            sum = sum + num;
            if(res.containsKey(sum-k)){
                count = count + res.get(sum-k);
            }
            res.put(sum, res.getOrDefault(sum,0)+1);
        }
        return count;
    }
}
