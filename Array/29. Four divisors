class Solution {
    public int sumFourDivisors(int[] nums) {
        int totalSum = 0;
        for (int num : nums) {
            totalSum += checkFourDivisors(num);
        }
        return totalSum;
    }

    private int checkFourDivisors(int num) {
        int count = 0;
        int sum = 0;
        // i*i is used to optimise the sol by square root of num
        for (int i = 2; i * i <= num; i++) {
            if (num % i == 0) {
                int j = num / i;

                // i and j are two divisors
                if (i == j) return 0; // square → not valid

                // Found first divisor pair
                count++;

                // More than one divisor pair → more than 4 divisors and we want only four divisors
                if (count > 1) return 0;

                sum = 1 + num + i + j;
            }
        }
        return count == 1 ? sum : 0;
    }
}
