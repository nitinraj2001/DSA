class Solution {
    public long beautifulSubarrays(int[] nums) {
        int xor = 0;
        long count = 0;
        HashMap<Integer, Long> res = new HashMap<>();
        res.put(0,1L); // because xor of a^0 will always be a
        for(int i =0;i<nums.length;i++){
            xor = xor^nums[i];
            if(res.containsKey(xor))count = count + res.get(xor);
            res.put(xor, res.getOrDefault(xor,0L) + 1L);
        }
        return count;
    }
}
