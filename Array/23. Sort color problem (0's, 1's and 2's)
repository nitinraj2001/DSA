class Solution {
    public void sortColors(int[] nums) {
        // This problem will be solve by 3 pointers approach
        int low = 0; // it will point to the index of 0's
        int mid = 0; // it point to current element
        int high = nums.length - 1; // it points to the index of 2's
        while(mid<=high){
            // if nums[mid] is equal to 0 then swap low and mid 
            // if it is equal to zero increment mid else swap with high
            if(nums[mid]==0){
                swap(nums,low,mid);
                low = low + 1;
                mid = mid + 1;
            }
           else if(nums[mid] == 1)mid = mid + 1;
           else if(nums[mid] == 2){
                swap(nums,mid,high);
                high = high - 1;
            }
        }
    }

    public void swap(int nums[], int first, int second){
        int temp = nums[first];
        nums[first] = nums[second];
        nums[second] = temp;
    }
}
